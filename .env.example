# Copy to .env and fill in your local Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shelfwatch?schema=public"

# Public origin for links that leave the app (printed join QR codes), e.g. https://shelfwatch.app.
# Optional in dev: without it the link uses the host the request came in on.
# APP_URL="http://192.168.1.20:3000"
