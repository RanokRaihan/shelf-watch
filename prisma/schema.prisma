// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id              String        @id @default(cuid())
  name            String
  location        String?
  timezone        String        @default("America/New_York")
  defaultLeadDays Int           @default(7)
  createdAt       DateTime      @default(now())
  users           User[]
  invites         StoreInvite[]
  devices         Device[]
  pullItems       PullItem[]

  storeProducts StoreProduct[]
}

model User {
  id                     String        @id @default(cuid())
  storeId                String
  store                  Store         @relation(fields: [storeId], references: [id])
  name                   String
  username               String        @unique
  role                   Role          @default(ASSOCIATE)
  status                 UserStatus    @default(PENDING)
  email                  String?       @unique
  phone                  String        @unique
  passwordHash           String?
  pinHash                String
  failedPinAttempts      Int           @default(0)
  lockedUntil            DateTime?
  failedPasswordAttempts Int           @default(0)
  passwordLockedUntil    DateTime?
  approvedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  invites                StoreInvite[]
  devices                Device[]
  createdPullItems       PullItem[]    @relation("PullItemCreatedBy")
  pullEvents             PullEvent[]
  sessions               Session[]
}

model StoreInvite {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  // Plain token, not a hash: join links are public by design (docs/auth-flow.md 5).
  token       String    @unique
  // Null = never expires. Store join links have no expiry; Rotate revokes them.
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Device {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  label      String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  sessions   Session[]

  @@index([userId])
}

model Session {
  id                     String    @id // sha256 of the cookie token
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId               String
  device                 Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  managerUntil           DateTime?
  failedPasswordAttempts Int       @default(0) // wrong passwords on /manage/login
  lastActiveAt           DateTime  @default(now())
  expiresAt              DateTime
  createdAt              DateTime  @default(now())

  @@index([userId])
  @@index([deviceId])
}

model Product {
  gtin          String         @id // 14 digits, zero-padded; UPC-A, UPC-E and EAN-13 of one item share it
  barcodeFormat BarcodeFormat
  barcodeValue  String // digits exactly as scanned, check digit included; what we print
  name          String?
  brand         String?
  size          String? // "80 sheets", "12 fl oz"
  category      String?
  imageUrl      String? // link to the source's image, not a copy
  lookupStatus  LookupStatus
  source        ProductSource?
  sourceData    Json? // raw API response
  lookedUpAt    DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pullItems     PullItem[]
  storeProducts StoreProduct[]
}

model StoreProduct {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  gtin          String
  product       Product   @relation(fields: [gtin], references: [gtin])
  name          String? // the store's own name; overrides Product.name
  itemNumber    String? // the store's SKU
  categoryName  String?
  aisle         String?
  section       String?
  shelf         String?
  leadDays      Int? // overrides Store.defaultLeadDays for this item
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, gtin])
  @@index([storeId, aisle])
}

model PullItem {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id])
  gtin        String
  product     Product     @relation(fields: [gtin], references: [gtin])
  productName String?
  expiryDate  DateTime?   @db.Date
  pullDate    DateTime    @db.Date
  status      PullStatus  @default(PENDING)
  pulledAt    DateTime?
  createdById String
  createdBy   User        @relation("PullItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      PullEvent[]

  @@index([storeId, status, pullDate])
}

model PullEvent {
  id         String     @id @default(cuid())
  pullItemId String
  pullItem   PullItem   @relation(fields: [pullItemId], references: [id])
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  action     PullAction
  createdAt  DateTime   @default(now())

  @@index([pullItemId])
}

enum Role {
  MANAGER
  MODERATOR
  ASSOCIATE
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PullStatus {
  PENDING
  PULLED
  SKIPPED
}

enum PullAction {
  CREATED
  EDITED
  PULLED
  SKIPPED
}

enum BarcodeFormat {
  UPC_A
  UPC_E
  EAN_13
  EAN_8
}

enum LookupStatus {
  FOUND
  NOT_FOUND
  FAILED
}

enum ProductSource {
  OPEN_FOOD_FACTS
  UPCITEMDB
}
