{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run db:generate)",
      "Bash(npm run auth:generate)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:push)",
      "Bash(npm run db:studio)",
      "Bash(npx drizzle-kit *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(npx drizzle-kit drop *)"
    ]
  }
}
